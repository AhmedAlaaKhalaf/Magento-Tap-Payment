<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <tap_payment>
                <active>0</active>
                <model>TapPaymentFacade</model>
                <title>Credit / Debit Card (Tap Payments)</title>
                <transaction_mode>charge</transaction_mode>
                <test_public_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <test_secret_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <api_url>https://api.tap.company/v2/</api_url>
                <source_id>src_all</source_id>
                <!-- Payment::place() requires a non-empty action; the initialize command ignores it. -->
                <payment_action>authorize</payment_action>
                <can_initialize>1</can_initialize>
                <is_gateway>1</is_gateway>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <order_status>pending_payment</order_status>
                <allowspecific>0</allowspecific>
                <debug>1</debug>
                <debugReplaceKeys>email,phone,first_name,last_name</debugReplaceKeys>
                <sort_order>10</sort_order>
                <paymentInfoKeys>tap_id,tap_object,tap_status,tap_response,tap_card</paymentInfoKeys>
                <privateInfoKeys>tap_object,tap_response</privateInfoKeys>
            </tap_payment>
        </payment>
    </default>
</config>
